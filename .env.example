# === Recrivo (AI Interview) 環境変数テンプレート ===
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# --- 必須: OpenAI API ---
# OPENAI_API_KEY=sk-your-openai-api-key

# --- DB / Redis ---
# DATABASE_URL=postgresql://recrivo:your-db-password@localhost:5432/recrivo_production
# REDIS_URL=redis://127.0.0.1:6379/3

# --- Rails ---
# RAILS_ENV=production
# RAILS_MASTER_KEY=your-master-key
# RAILS_ALLOWED_HOST=recrivo.example.com

# --- Stripe (サブスクリプション) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# JPY
# STRIPE_PRICE_STANDARD=price_...          # Standard ¥59,800/月
# STRIPE_PRICE_BUSINESS=price_...          # Business ¥98,000/月
# STRIPE_PRICE_ENTERPRISE=price_...        # Enterprise ¥198,000/月
# USD
# STRIPE_PRICE_STANDARD_USD=price_...      # Standard $399/月
# STRIPE_PRICE_BUSINESS_USD=price_...      # Business $699/月
# STRIPE_PRICE_ENTERPRISE_USD=price_...    # Enterprise $1,299/月
# Standard 初回3ヶ月15%OFF（Stripe Coupon ID）
# STRIPE_COUPON_STANDARD_INTRO=coupon_...
# （Starter は新規販売停止。既存ENVがあってもLP/Checkoutには出しません）
# STRIPE_PRICE_STARTER=price_...

# --- OAuth (Google / Microsoft) ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Redirect URI 例: https://your-domain/clients/auth/google_oauth2/callback
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# Redirect URI 例: https://your-domain/clients/auth/microsoft_graph/callback
