- set_meta_tags \
    title: "AI面接システム｜採用の一次面接を自動化", \
    description: "面接シナリオを作成して招待リンクを送るだけ。AIが音声・選択式の回答を評価し、合否判定まで自動化。採用の一次面接工数を削減します。", \
    og: { title: "AI Interview｜採用の一次面接を自動化", type: "website" }


.meetia-modern-lp
  header.meetia-nav
    .meetia-nav__inner
      = link_to root_path, class: "meetia-nav__logo" do
        = image_tag "meetia_logo.png", alt: "AI Interview", class: "meetia-nav__logo-image"
      button.meetia-nav__toggle type="button" aria-label="メニュー" data-lp-nav-toggle=""
        span
        span
        span
      nav.meetia-nav__menu data-lp-nav-menu=""
        - TopsHelper::LP_NAV_ITEMS.each do |item|
          = link_to item[:label], item[:href], class: "meetia-nav__item"
        .meetia-nav__menu-actions
          = link_to lp_login_label, lp_login_path, class: "meetia-btn meetia-btn--ghost meetia-btn--sm"
          = link_to "無料トライアル", lp_sign_up_path, class: "meetia-btn meetia-btn--primary meetia-btn--sm"

  section#top.meetia-hero.meetia-hero--diagonal
    .meetia-hero__diagonal-bg aria-hidden="true"
    .meetia-hero__inner
      .meetia-hero__content
        .meetia-hero__badge
          i.fa-solid.fa-user-tie aria-hidden="true"
          span AI Interview Agent
        h1.meetia-hero__title
          | AIによる本格面接
          br
          | 採用面接へようこそ
        p.meetia-hero__lead シナリオを作ってリンクを送るだけ。候補者はいつでも受験でき、AIが評価・合否まで進めます。
        .meetia-hero__actions
          = link_to lp_trial_experience_path, lp_trial_experience_link_options.merge(class: "meetia-btn meetia-btn--primary meetia-btn--lg meetia-btn--cta-play") do
            span 無料トライアル
            span.meetia-btn__play-icon aria-hidden="true"
              i.fa-solid.fa-play
          = link_to "機能を見る", "#features", class: "meetia-btn meetia-btn--outline meetia-btn--lg"

      .meetia-hero__visual aria-hidden="true"
        .meetia-hero-portal
          = image_tag "top_hero.png", class: "meetia-hero-portal__scene", alt: "AI Interview 面接ルームのイメージ"

    .meetia-hero__features
      - TopsHelper::HERO_FEATURE_CARDS.each do |icon, title, body|
        .meetia-hero__feature-card
          .meetia-hero__feature-icon
            i.fa-solid class=icon aria-hidden="true"
          h3.meetia-hero__feature-title = title
          p.meetia-hero__feature-body = body

  /.meetia-logos
    p.meetia-logos__title 多くの企業様にご利用いただいています
    .meetia-logos__wrapper
      - %w[TechCorp NextVision CloudScale DataBridge InnovateX GlobalNet FutureWorks SmartBiz].each do |name|
        span.meetia-logos__item = name

        

  section.meetia-whats
    .meetia-whats__inner
      span.meetia-section__eyebrow What's AI Interview?

      /-- 背景枠カード --/
      .meetia-whats__container-card
        
        /-- 完全に右側背景としてなじませるアバター（左側のテキスト領域に干渉させない） --/
        .meetia-whats__backdrop-visual
          .meetia-whats__glow-effect
          = image_tag "whats.png", class: "meetia-whats__avatar-backdrop", alt: ""

        /-- 枠内コンテンツ（z-indexでアバターより必ず前面に表示） --/
        .meetia-whats__card-body
          
          /-- 上半分のテキスト ＋ 実績エリア --/
          .meetia-whats__hero-block
            .meetia-whats__text-group
              h2.meetia-whats__main-title
                = image_tag "meetia_logo.png", class: "meetia-whats__logo-graphics", alt: "AI Interview"
                span とは？
              p.meetia-whats__catch AIが変える採用面接の未来
              p.meetia-whats__description
                | AI Interviewは、最先端のAI技術を活用した採用面接エージェントです。
                span.meetia-whats__description-more
                  br
                  | 質問設計に沿って、24時間365日、候補者との一次面接を自動で行います。
                  br
                  | シナリオ作成から評価・合否判定まで、すべてAIにお任せいただけます。

            /-- 実績数値メーター --/
            .meetia-whats__metrics-row
              .meetia-whats__metric-item
                .meetia-whats__metric-icon-wrap
                  i.fa-solid.fa-clock-rotate-left
                  span 24h
                .meetia-whats__metric-texts
                  span.meetia-whats__metric-label 24時間365日
                  span.meetia-whats__metric-value いつでも稼働
              .meetia-whats__metric-item
                .meetia-whats__metric-icon-wrap
                  i.fa-solid.fa-users
                .meetia-whats__metric-texts
                  span.meetia-whats__metric-label 候補者対応力
                  span.meetia-whats__metric-value 300%向上
              .meetia-whats__metric-item
                .meetia-whats__metric-icon-wrap
                  i.fa-solid.fa-chart-line
                .meetia-whats__metric-texts
                  span.meetia-whats__metric-label 一次面接スループット
                  span.meetia-whats__metric-value 250%向上

          /-- 魅力カードグリッド（等幅・等高で枠の中に綺麗に収める） --/
          .meetia-whats__features-grid
            .meetia-whats__feature-box
              .meetia-whats__feature-icon-circle
                i.fa-solid.fa-comments
              h4.meetia-whats__feature-box-title 一貫した評価基準
              p.meetia-whats__feature-box-desc 同じシナリオ・同じ基準で、候補者を公平に評価します。

            .meetia-whats__feature-box
              .meetia-whats__feature-icon-circle
                i.fa-solid.fa-clock
              h4.meetia-whats__feature-box-title 24時間稼働
              p.meetia-whats__feature-box-desc 時間や場所を問わず、候補者が都合の良いタイミングで受験可能。

            .meetia-whats__feature-box
              .meetia-whats__feature-icon-circle
                i.fa-solid.fa-bullseye
              h4.meetia-whats__feature-box-title 高精度な採点
              p.meetia-whats__feature-box-desc AIが回答内容を分析し、スコアと合否を自動判定。

            .meetia-whats__feature-box
              .meetia-whats__feature-icon-circle
                i.fa-solid.fa-chart-column
              h4.meetia-whats__feature-box-title 選考の可視化
              p.meetia-whats__feature-box-desc 結果・スコア・回答ログを可視化し、採用改善に活用できます。



