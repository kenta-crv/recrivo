.meetia-modern-lp
  = render "tops/shared/nav"
  = render "tops/shared/page_hero", eyebrow: "REVIEWS", title: "導入企業の声", lead: "Recrivoをご利用いただいている企業様からのフィードバックです。"

  section.meetia-section
    .meetia-section__inner
      .meetia-cases__grid
        - TopsHelper::REVIEW_CARDS.first(2).each do |card|
          .meetia-cases__card
            .meetia-cases__meta = card[:meta]
            .meetia-cases__stars ★★★★★
            h3 = card[:title]
            p = card[:quote]
            span.meetia-cases__metric = card[:metric]

  = render "tops/shared/cta_band"
  = render "tops/shared/footer"
