footer.meetia-footer
  .meetia-footer__glow aria-hidden="true"
  .meetia-footer__inner
    .meetia-footer__brand
      = link_to locale_root_href, class: "meetia-footer__logo-link" do
        = image_tag "recrivo_logo.png", alt: "AI Interview", class: "meetia-footer__logo-image"
      p.meetia-footer__tagline = t("recrivo.lp.footer_tagline")
      p.meetia-footer__desc = t("recrivo.lp.footer_desc")
    nav.meetia-footer__nav aria-label=t("recrivo.lp.footer_product")
      h3.meetia-footer__nav-title = t("recrivo.lp.footer_product")
      .meetia-footer__nav-links
        - lp_nav_items.reject { |item| item[:key] == "columns" }.first(4).each do |item|
          = link_to item[:label], item[:href], class: "meetia-footer__link"
    nav.meetia-footer__nav aria-label=t("recrivo.lp.footer_support")
      h3.meetia-footer__nav-title = t("recrivo.lp.footer_support")
      .meetia-footer__nav-links
        - lp_nav_items.last(3).each do |item|
          = link_to item[:label], item[:href], class: "meetia-footer__link"
    .meetia-footer__cta
      h3.meetia-footer__nav-title = t("recrivo.lp.footer_try_now")
      p = t("recrivo.lp.footer_trial_text", days: Subscription::TRIAL_DAYS)
      = link_to lp_trial_experience_path, lp_trial_experience_link_options.merge(class: "meetia-btn meetia-btn--primary meetia-btn--sm meetia-btn--pill") do
        i.fa-solid.fa-bolt aria-hidden="true"
        span = t("recrivo.lp.cta_trial")
  .meetia-footer__bottom
    p.meetia-footer__copy © #{Time.current.year} Recrivo / J Work Inc.
    .meetia-footer__bottom-links
      = link_to "#faq", class: "meetia-footer__bottom-link" do
        | FAQ
      = link_to "#company", class: "meetia-footer__bottom-link" do
        = t("recrivo.lp.footer_company")
