script
  | (function(){var KEY="meetia-dashboard-theme";function bg(t){var teal=document.documentElement.getAttribute("data-dashboard-palette")==="teal";return t==="light"?(teal?"#f1f5f9":"#ffffff"):(teal?"#0f172a":"#0a0a12");}function apply(theme){var t=theme==="dark"?"dark":"light";var r=document.documentElement;r.setAttribute("data-dashboard-theme",t);r.classList.toggle("dashboard-theme-dark",t==="dark");r.classList.toggle("dashboard-theme-light",t==="light");r.style.colorScheme=t;r.style.backgroundColor=bg(t);try{localStorage.setItem(KEY,t);}catch(e){}document.querySelectorAll("[data-dashboard-theme-value]").forEach(function(btn){var on=btn.getAttribute("data-dashboard-theme-value")===t;btn.classList.toggle("is-active",on);btn.setAttribute("aria-pressed",on?"true":"false");});var c=document.getElementById("dashboard-v2-container");if(c){c.classList.toggle("is-theme-dark",t==="dark");c.classList.toggle("is-theme-light",t==="light");}}window.applyMeetiaDashboardTheme=apply;try{apply(localStorage.getItem(KEY)==="dark"?"dark":"light");}catch(e){apply("light");}document.addEventListener("click",function(e){var n=e.target;if(n&&n.nodeType!==1)n=n.parentElement;var btn=n&&n.closest&&n.closest("[data-dashboard-theme-value]");if(!btn)return;e.preventDefault();apply(btn.getAttribute("data-dashboard-theme-value"));},true);function sync(){apply(document.documentElement.getAttribute("data-dashboard-theme")||"light");}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",sync);}else{sync();}document.addEventListener("turbo:load",sync);})();
