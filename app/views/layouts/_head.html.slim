meta charset="UTF-8"
meta name="viewport" content="width=device-width, initial-scale=1.0"
meta name="format-detection" content="telephone=no"

= csrf_meta_tags
= csp_meta_tag
= display_meta_tags default_meta_tags
= favicon_link_tag "favicon.ico"
link rel="apple-touch-icon" href=image_path("favicon.ico")
link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet"

- if controller_name == "tops" && action_name == "index"
  script type="application/ld+json"
    == lp_structured_data_json


- if @hide_site_chrome
  / 面接室は LP/Bootstrap/application.css を混ぜない（ボタン不能・レイアウト崩れの原因になる）
  = stylesheet_link_tag "interview", media: "all", "data-turbo-track": "reload"
- else
  link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
  = stylesheet_link_tag "application", media: "all", "data-turbolinks-track": "reload"
