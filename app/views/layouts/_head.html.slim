meta charset="UTF-8"
meta name="viewport" content="width=device-width, initial-scale=1.0"
meta name="format-detection" content="telephone=no"

= csrf_meta_tags
= csp_meta_tag
= display_meta_tags default_meta_tags
= favicon_link_tag "favicon.ico"
link rel="apple-touch-icon" href=image_path("favicon.ico")
- if respond_to?(:href_for_locale)
  link rel="alternate" hreflang="ja" href="#{request.base_url}#{href_for_locale(:ja)}"
  link rel="alternate" hreflang="en" href="#{request.base_url}#{href_for_locale(:en)}"
  link rel="alternate" hreflang="x-default" href="#{request.base_url}#{href_for_locale(:ja)}"
/ LP 以外用。LP は layouts/lp.html.slim 側で Drafty フォントを読み込む
- unless controller_name == "tops"
  link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet"
script async=true src="https://s.yimg.jp/images/listing/tool/cv/ytag.js"

javascript:
  window.yjDataLayer = window.yjDataLayer || [];
  function ytag() { yjDataLayer.push(arguments); }
  ytag({"type":"ycl_cookie", "config":{"ycl_use_non_cookie_storage":true}});

  
- if controller_name == "tops" && action_name == "index"
  script type="application/ld+json"
    == lp_structured_data_json


- if @hide_site_chrome
  / 面接室は LP/Bootstrap/application.css を混ぜない（ボタン不能・レイアウト崩れの原因になる）
  = stylesheet_link_tag "interview", media: "all", "data-turbo-track": "reload"
- else
  link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
  = stylesheet_link_tag "application", media: "all", "data-turbolinks-track": "reload"
