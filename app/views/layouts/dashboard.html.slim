doctype html
html.dashboard-html lang="ja"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    meta name="robots" content="noindex, nofollow"
    title AI Interview ダッシュボード
    = csrf_meta_tags
    = csp_meta_tag
    = favicon_link_tag "favicon.ico"
    / LP用 Bootstrap / application.css（tops混入）を読まない。ダッシュボード専用CSSのみ。
    link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet"
    = stylesheet_link_tag "dashboard", media: "all", "data-turbo-track": "reload"
    link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin=""
    link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer"
    script
      | (function(){try{var t=localStorage.getItem("meetia-dashboard-theme");if(t!=="light"&&t!=="dark"){t="light";}document.documentElement.setAttribute("data-dashboard-theme",t);var teal=document.documentElement.getAttribute("data-dashboard-palette")==="teal";document.documentElement.style.backgroundColor=t==="light"?(teal?"#f1f5f9":"#ffffff"):(teal?"#0f172a":"#0a0a12");}catch(e){document.documentElement.setAttribute("data-dashboard-theme","light");document.documentElement.style.backgroundColor="#ffffff";}})();

  body.dashboard-body
    .dashboard-v2-container#dashboard-v2-container
      .db-v2-sidebar__overlay data-dashboard-sidebar-overlay=""
      = render "/dashboard/sidebar"

      .db-v2-main-content
        .db-v2-mobile-bar
          button.db-v2-sidebar__toggle type="button" aria-label="メニューを開く" data-dashboard-sidebar-toggle=""
            i.fa-solid.fa-bars aria-hidden="true"
          span.db-v2-mobile-bar__label Dashboard
        - if flash.any?
          .db-v2-flash-stack
            - flash.each do |type, message|
              - next if message.blank?
              - alert_class = type.to_sym == :notice ? "db-v2-alert--success" : (type.to_sym == :alert ? "db-v2-alert--danger" : "db-v2-alert--info")
              - icon_class = type.to_sym == :notice ? "fa-circle-check" : (type.to_sym == :alert ? "fa-circle-exclamation" : "fa-circle-info")
              .db-v2-alert class=alert_class
                i.fa-solid class=icon_class aria-hidden="true"
                p = message
        - hide_toolbar = (controller_name == "dashboard" && action_name == "index") || controller_name == "situations" || controller_name == "questions" || controller_name == "interview_results" || controller_name == "management" || controller_name == "plans" || controller_path == "admin/interview_results" || controller_name == "accounts" || controller_name == "subscriptions" || controller_name == "problems" || controller_name == "candidates" || controller_name == "notifications" || controller_name == "situation_faqs"
        - unless hide_toolbar
          = render "/dashboard/dashboard_toolbar"
        = yield

      - if client_signed_in? || admin_signed_in?
        = render "problems/modal"

    = javascript_include_tag "dashboard", "data-turbo-track": "reload"
