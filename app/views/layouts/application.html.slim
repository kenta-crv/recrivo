doctype html
html lang=I18n.locale data-turbo=(@hide_site_chrome ? "false" : nil)
  head
    = render "layouts/head"

  body class=(@hide_site_chrome ? "interview-room-body" : nil)
    - unless @hide_site_chrome
      = render "layouts/header"
      = render "shared/breadcrumbs" if breadcrumbs.any?
    = yield
    - if @hide_site_chrome
      / 面接室はダッシュボード/LP用 application.js を読まない
      = javascript_include_tag "interview", "data-turbo-track": "reload"
    - else
      script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.13/dist/turbo.es2017-umd.js"
      = javascript_include_tag "application", "data-turbolinks-track": "reload"
