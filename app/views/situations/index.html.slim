.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("recrivo.dashboard.situations.index_title")
    p.db-v2-header__subtitle
      - if acting_as_admin?
        = t("recrivo.dashboard.situations.index_subtitle_admin")
      - else
        - plan = current_client.current_plan_config
        - situation_limit = current_client.situation_limit
        - if situation_limit
          = t("recrivo.dashboard.situations.index_subtitle_limited", plan: localized_plan_name(plan), used: current_client.active_services_count, limit: situation_limit)
        - else
          = t("recrivo.dashboard.situations.index_subtitle_unlimited", plan: localized_plan_name(plan), used: current_client.active_services_count)
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
      i.fa-solid.fa-plus aria-hidden="true"
      span = t("recrivo.dashboard.situations.create")

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.situations.list_title")
    span.db-v2-deals-count = t("recrivo.dashboard.common.count", count: @situations.size)

  .db-v2-bottom-card__body
    - if @situations.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-list-check aria-hidden="true"
        p.db-v2-empty-state__text = t("recrivo.dashboard.situations.empty")
        = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
          i.fa-solid.fa-plus aria-hidden="true"
          span = t("recrivo.dashboard.situations.create_first")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table.db-v2-situations-table
          thead
            tr
              th = t("recrivo.dashboard.situations.col_id")
              - if acting_as_admin?
                th = t("recrivo.dashboard.situations.col_company")
              th.db-v2-situations-table__title = t("recrivo.dashboard.situations.col_title")
              th.db-v2-situations-table__num = t("recrivo.dashboard.situations.col_language")
              th.db-v2-situations-table__num = t("recrivo.dashboard.situations.col_questions")
              th.db-v2-situations-table__status = t("recrivo.dashboard.situations.col_status")
              th.db-v2-situations-table__date = t("recrivo.dashboard.situations.col_updated")
              th.db-v2-situations-table__actions = t("recrivo.dashboard.situations.col_actions")
          tbody
            - @situations.each do |situation|
              tr
                td.db-v2-situations-table__id.db-v2-deals-table__id = situation.id
                - if acting_as_admin?
                  td = situation.client&.company.presence || situation.client&.email || "—"
                td.db-v2-situations-table__title.db-v2-deals-table__title
                  .db-v2-situations-table__title-inner
                    = link_to situation.title, situation_path(situation), class: "db-v2-deals-table__link"
                    - if situation.industry.present? || situation.job_title.present?
                      span.db-v2-situations-table__meta = [situation.industry.presence, situation.job_title.presence].compact.join(t("recrivo.dashboard.common.sep"))
                td.db-v2-situations-table__num = situation.language.to_s.upcase
                td.db-v2-situations-table__num = situation.questions.size
                td.db-v2-situations-table__status
                  - if situation.archived?
                    span.db-v2-status-badge = t("recrivo.dashboard.common.archived")
                  - else
                    span.db-v2-status-badge.db-v2-status-badge--live = t("recrivo.dashboard.common.active")
                td.db-v2-situations-table__date = l(situation.updated_at, format: :short)
                td.db-v2-situations-table__actions
                  .db-v2-deals-table__actions
                    = link_to situation_path(situation), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                      span = t("recrivo.dashboard.common.detail")
                    = link_to edit_situation_path(situation), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                      span = t("recrivo.dashboard.common.edit")
                    = button_to situation_path(situation), method: :delete, class: "db-v2-btn db-v2-btn--danger db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo_confirm: t("recrivo.dashboard.situations.delete_confirm"), confirm: t("recrivo.dashboard.situations.delete_confirm") } do
                      span = t("recrivo.dashboard.common.delete")
