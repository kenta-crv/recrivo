= form_with model: @situation, local: true, html: { class: "db-v2-situation-form", data: { situation_form: "1" } } do |f|
  .db-v2-form-section
    h3.db-v2-form-section__title 基本情報
    - if acting_as_admin? && @situation.new_record?
      .db-v2-form-group
        = f.label :client_id, "契約企業", class: "db-v2-form-label"
        = f.collection_select :client_id, (@clients || []), :id, :admin_select_label, { include_blank: "企業を選択" }, class: "db-v2-form-control", required: true
        p.db-v2-form-hint このシナリオを紐づける企業アカウントを選択してください。

    .db-v2-form-group
      = f.label :title, "タイトル", class: "db-v2-form-label"
      = f.text_field :title, class: "db-v2-form-control", required: true, placeholder: "例: エンジニア一次面接"

    .db-v2-form-group
      = f.label :industry, "業種", class: "db-v2-form-label"
      = f.text_field :industry, class: "db-v2-form-control", required: true, placeholder: "例: IT・Web、人材、製造、小売"
      p.db-v2-form-hint AIが面接質問を提案するときの前提になります。

    .db-v2-form-group
      = f.label :job_title, "募集職種", class: "db-v2-form-label"
      = f.text_field :job_title, class: "db-v2-form-control", required: true, placeholder: "例: バックエンドエンジニア、営業、カスタマーサクセス"

    .db-v2-form-group
      = f.label :description, "説明（任意）", class: "db-v2-form-label"
      = f.text_area :description, class: "db-v2-form-control", rows: 2, placeholder: "社内メモ（候補者には表示されません）"

    .db-v2-form-group
      = f.label :language, "言語", class: "db-v2-form-label"
      = f.select :language, [["日本語", "ja"], ["English", "en"]], {}, class: "db-v2-form-control"

  .db-v2-form-section
    h3.db-v2-form-section__title 合否と回答方式
    .db-v2-form-group
      = f.label :passing_score, "合格ライン（平均点）", class: "db-v2-form-label"
      = f.number_field :passing_score, class: "db-v2-form-control", min: 0, max: 100
      p.db-v2-form-hint 例: 70 なら平均 70 点以上で合格。

    .db-v2-form-group
      label.db-v2-form-label 許可する回答手段
      .db-v2-form-check
        = f.check_box :allow_text_answer
        = f.label :allow_text_answer, "テキスト"
      .db-v2-form-check
        = f.check_box :allow_voice_answer
        = f.label :allow_voice_answer, "音声"
      p.db-v2-form-hint 少なくとも一方は有効にしてください。

  details.db-v2-details
    summary.db-v2-details__summary 詳細設定（通常は変更不要）
    .db-v2-details__body
      .db-v2-form-section
        h3.db-v2-form-section__title 判定
        .db-v2-form-group
          = f.label :judgment_mode, "判定モード", class: "db-v2-form-label"
          = f.select :judgment_mode, [["自動判定（スコアで合否）", "automatic"], ["面接官が判定（結果は要確認）", "manual"]], {}, class: "db-v2-form-control"

        .db-v2-form-group
          = f.label :candidate_result_visibility, "候補者への結果表示", class: "db-v2-form-label"
          = f.select :candidate_result_visibility, [["非表示（推奨・後日連絡）", "hidden"], ["その場で詳細を表示", "immediate"]], {}, class: "db-v2-form-control"
          p.db-v2-form-hint 総評・推薦は採用側向けです。通常は非表示のままにしてください。

      .db-v2-form-section
        h3.db-v2-form-section__title 途中での不合格条件
        p.db-v2-form-hint style="margin-bottom:12px"
          | 不要ならオフのままにしてください。

        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :auto_reject_enabled, data: { auto_reject_toggle: "1" }
            = f.label :auto_reject_enabled, "途中不合格を使う"

        #auto-reject-details data-auto-reject-details="1"
          .db-v2-page-card
            .db-v2-form-group
              .db-v2-form-check
                = f.check_box :reject_on_required_fail
                = f.label :reject_on_required_fail, "必須質問が基準未満なら不合格にする"

            .db-v2-form-group
              = f.label :min_required_score, "必須質問の合格ライン（点）", class: "db-v2-form-label"
              = f.number_field :min_required_score, class: "db-v2-form-control", min: 0, max: 100

            .db-v2-form-group
              = f.label :max_consecutive_fails, "連続で基準未達が続いたら不合格", class: "db-v2-form-label"
              = f.number_field :max_consecutive_fails, class: "db-v2-form-control", min: 0, max: 50
              p.db-v2-form-hint 使わない場合は 0。

            .db-v2-form-group
              = f.label :reject_notify_method, "途中不合格時の通知", class: "db-v2-form-label"
              = f.select :reject_notify_method, [["アプリ内", "in_app"], ["メール", "email"], ["なし", "none"]], {}, class: "db-v2-form-control"

      .db-v2-form-section
        h3.db-v2-form-section__title カメラ・セッション
        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :record_camera
            = f.label :record_camera, "面接中にカメラ映像を表示・録画する"

        .db-v2-form-group
          = f.label :session_timeout_minutes, "無操作でタイムアウト（分）", class: "db-v2-form-label"
          = f.number_field :session_timeout_minutes, class: "db-v2-form-control", min: 1, max: 180

        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :allow_resume
            = f.label :allow_resume, "途中離脱しても再開を許可する"

        .db-v2-form-group
          = f.label :max_resume_count, "再開できる最大回数", class: "db-v2-form-label"
          = f.number_field :max_resume_count, class: "db-v2-form-control", min: 0, max: 10

      - if @situation.persisted?
        .db-v2-form-section
          h3.db-v2-form-section__title その他
          .db-v2-form-group
            .db-v2-form-check
              = f.check_box :archived
              = f.label :archived, "アーカイブする（新規招待を止める）"

  .db-v2-form-actions
    = f.submit @situation.persisted? ? "更新する" : "作成する", class: "db-v2-btn db-v2-btn--primary"
    = link_to (@situation.persisted? ? situation_path(@situation) : situations_path), class: "db-v2-btn db-v2-btn--ghost" do
      span キャンセル
