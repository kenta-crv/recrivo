= form_with model: @situation, local: true, html: { class: "db-v2-situation-form", data: { situation_form: "1" } } do |f|
  .db-v2-form-section
    h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.basic")
    - if acting_as_admin? && @situation.new_record?
      .db-v2-form-group
        = f.label :client_id, t("recrivo.dashboard.situations.form.client"), class: "db-v2-form-label"
        = f.collection_select :client_id, (@clients || []), :id, :admin_select_label, { include_blank: t("recrivo.dashboard.situations.form.client_blank") }, class: "db-v2-form-control", required: true
        p.db-v2-form-hint = t("recrivo.dashboard.situations.form.client_hint")

    .db-v2-form-group
      = f.label :title, t("recrivo.dashboard.situations.form.title"), class: "db-v2-form-label"
      = f.text_field :title, class: "db-v2-form-control", required: true, placeholder: t("recrivo.dashboard.situations.form.title_ph")

    .db-v2-form-group
      = f.label :industry, t("recrivo.dashboard.situations.form.industry"), class: "db-v2-form-label"
      = f.text_field :industry, class: "db-v2-form-control", required: true, placeholder: t("recrivo.dashboard.situations.form.industry_ph")
      p.db-v2-form-hint = t("recrivo.dashboard.situations.form.industry_hint")

    .db-v2-form-group
      = f.label :job_title, t("recrivo.dashboard.situations.form.job_title"), class: "db-v2-form-label"
      = f.text_field :job_title, class: "db-v2-form-control", required: true, placeholder: t("recrivo.dashboard.situations.form.job_title_ph")

    .db-v2-form-group
      = f.label :description, t("recrivo.dashboard.situations.form.description"), class: "db-v2-form-label"
      = f.text_area :description, class: "db-v2-form-control", rows: 2, placeholder: t("recrivo.dashboard.situations.form.description_ph")

    .db-v2-form-group
      = f.label :language, t("recrivo.dashboard.situations.form.language"), class: "db-v2-form-label"
      = f.select :language, [[t("recrivo.dashboard.situations.form.language_ja"), "ja"], [t("recrivo.dashboard.situations.form.language_en"), "en"]], {}, class: "db-v2-form-control"

  .db-v2-form-section
    h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.judgment_section")
    .db-v2-form-group
      = f.label :passing_score, t("recrivo.dashboard.situations.form.passing_score"), class: "db-v2-form-label"
      = f.number_field :passing_score, class: "db-v2-form-control", min: 0, max: 100
      p.db-v2-form-hint = t("recrivo.dashboard.situations.form.passing_hint")

    .db-v2-form-group
      label.db-v2-form-label = t("recrivo.dashboard.situations.form.answer_modes")
      .db-v2-form-check
        = f.check_box :allow_text_answer
        = f.label :allow_text_answer, t("recrivo.dashboard.situations.form.text")
      .db-v2-form-check
        = f.check_box :allow_voice_answer
        = f.label :allow_voice_answer, t("recrivo.dashboard.situations.form.voice")
      p.db-v2-form-hint = t("recrivo.dashboard.situations.form.answer_hint")

  details.db-v2-details
    summary.db-v2-details__summary = t("recrivo.dashboard.situations.form.advanced")
    .db-v2-details__body
      .db-v2-form-section
        h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.judgment")
        .db-v2-form-group
          = f.label :judgment_mode, t("recrivo.dashboard.situations.form.judgment_mode"), class: "db-v2-form-label"
          = f.select :judgment_mode, [[t("recrivo.dashboard.situations.form.judgment_automatic"), "automatic"], [t("recrivo.dashboard.situations.form.judgment_manual"), "manual"]], {}, class: "db-v2-form-control"

        .db-v2-form-group
          = f.label :candidate_result_visibility, t("recrivo.dashboard.situations.form.result_visibility"), class: "db-v2-form-label"
          = f.select :candidate_result_visibility, [[t("recrivo.dashboard.situations.form.result_hidden"), "hidden"], [t("recrivo.dashboard.situations.form.result_immediate"), "immediate"]], {}, class: "db-v2-form-control"
          p.db-v2-form-hint = t("recrivo.dashboard.situations.form.result_hint")

      .db-v2-form-section
        h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.auto_reject_section")
        p.db-v2-form-hint style="margin-bottom:12px" = t("recrivo.dashboard.situations.form.auto_reject_hint")

        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :auto_reject_enabled, data: { auto_reject_toggle: "1" }
            = f.label :auto_reject_enabled, t("recrivo.dashboard.situations.form.auto_reject_enable")

        #auto-reject-details data-auto-reject-details="1"
          .db-v2-page-card
            .db-v2-form-group
              .db-v2-form-check
                = f.check_box :reject_on_required_fail
                = f.label :reject_on_required_fail, t("recrivo.dashboard.situations.form.reject_on_required_fail")

            .db-v2-form-group
              = f.label :min_required_score, t("recrivo.dashboard.situations.form.min_required_score"), class: "db-v2-form-label"
              = f.number_field :min_required_score, class: "db-v2-form-control", min: 0, max: 100

            .db-v2-form-group
              = f.label :max_consecutive_fails, t("recrivo.dashboard.situations.form.max_consecutive_fails"), class: "db-v2-form-label"
              = f.number_field :max_consecutive_fails, class: "db-v2-form-control", min: 0, max: 50
              p.db-v2-form-hint = t("recrivo.dashboard.situations.form.max_consecutive_hint")

            .db-v2-form-group
              = f.label :reject_notify_method, t("recrivo.dashboard.situations.form.reject_notify"), class: "db-v2-form-label"
              = f.select :reject_notify_method, [[t("recrivo.dashboard.situations.form.notify_in_app"), "in_app"], [t("recrivo.dashboard.situations.form.notify_email"), "email"], [t("recrivo.dashboard.situations.form.notify_none"), "none"]], {}, class: "db-v2-form-control"

      .db-v2-form-section
        h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.camera_section")
        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :record_camera
            = f.label :record_camera, t("recrivo.dashboard.situations.form.record_camera")

        .db-v2-form-group
          = f.label :session_timeout_minutes, t("recrivo.dashboard.situations.form.session_timeout"), class: "db-v2-form-label"
          = f.number_field :session_timeout_minutes, class: "db-v2-form-control", min: 1, max: 180

        .db-v2-form-group
          .db-v2-form-check
            = f.check_box :allow_resume
            = f.label :allow_resume, t("recrivo.dashboard.situations.form.allow_resume")

        .db-v2-form-group
          = f.label :max_resume_count, t("recrivo.dashboard.situations.form.max_resume"), class: "db-v2-form-label"
          = f.number_field :max_resume_count, class: "db-v2-form-control", min: 0, max: 10

      - if @situation.persisted?
        .db-v2-form-section
          h3.db-v2-form-section__title = t("recrivo.dashboard.situations.form.other")
          .db-v2-form-group
            .db-v2-form-check
              = f.check_box :archived
              = f.label :archived, t("recrivo.dashboard.situations.form.archive")

  .db-v2-form-actions
    = f.submit @situation.persisted? ? t("recrivo.dashboard.questions.update") : t("recrivo.dashboard.questions.create"), class: "db-v2-btn db-v2-btn--primary"
    = link_to (@situation.persisted? ? situation_path(@situation) : situations_path), class: "db-v2-btn db-v2-btn--ghost" do
      span = t("recrivo.dashboard.common.cancel")
