.db-v2-header
  .db-v2-header__left
    nav.db-v2-breadcrumb aria-label="パンくず"
      = link_to dashboard_index_path, class: "db-v2-breadcrumb__link" do
        i.fa-solid.fa-gauge-high aria-hidden="true"
        span ダッシュボード
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      = link_to "シナリオ管理", situations_path, class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      span.db-v2-breadcrumb__current = @situation.title
    h1.db-v2-header__title = @situation.title
    p.db-v2-header__subtitle
      - if @situation.industry.present? || @situation.job_title.present?
        = [@situation.industry.presence, @situation.job_title.presence].compact.join(" ／ ")
        |  ／ 
      = @situation.description.presence || "説明未設定"
      |  ／ 言語 #{@situation.language.to_s.upcase}
      - if @situation.archived?
        |  ／ アーカイブ中
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to edit_situation_path(@situation), class: "db-v2-btn db-v2-btn--ghost" do
      i.fa-solid.fa-pen aria-hidden="true"
      span 編集
    = link_to new_situation_question_path(@situation), class: "db-v2-btn db-v2-btn--primary" do
      i.fa-solid.fa-plus aria-hidden="true"
      span 質問を追加

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title 招待リンク
  .db-v2-bottom-card__body
    p.db-v2-muted 候補者にこのURLを共有してください（ログイン不要）。閲覧数: #{@situation.page_views_count}
    .db-v2-form-group
      input.db-v2-form-control#invite-url-field type="text" readonly=true value=interview_invite_url(@situation.invite_token)
    .db-v2-form-actions
      button.db-v2-btn.db-v2-btn--primary type="button" data-copy-text-from="#invite-url-field"
        i.fa-solid.fa-copy aria-hidden="true"
        span リンクをコピー
      = link_to interview_invite_path(@situation.invite_token), class: "db-v2-btn db-v2-btn--ghost", target: "_blank", rel: "noopener", data: { turbo: false } do
        i.fa-solid.fa-arrow-up-right-from-square aria-hidden="true"
        span 面接ページを開く
      = link_to interview_invite_path(@situation.invite_token, preview: 1), class: "db-v2-btn db-v2-btn--ghost", target: "_blank", rel: "noopener", data: { turbo: false } do
        i.fa-solid.fa-eye aria-hidden="true"
        span プレビュー（記録なし）
      = button_to regenerate_invite_token_situation_path(@situation), method: :post, class: "db-v2-btn db-v2-btn--ghost", form: { class: "db-v2-inline-form" }, data: { turbo_confirm: "既存リンクは無効になります。再発行しますか？", confirm: "既存リンクは無効になります。再発行しますか？" } do
        span リンクを再発行

.db-v2-bottom-card style="margin-top: 1.25rem"
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title 合否ルール
    = link_to "編集", edit_situation_path(@situation), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
  .db-v2-bottom-card__body
    p.db-v2-muted = situation_judgment_summary(@situation)

.db-v2-bottom-card style="margin-top: 1.25rem" data-ai-suggest-card="1" data-suggest-url=suggest_questions_situation_path(@situation) data-apply-url=apply_suggested_questions_situation_path(@situation)
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title AIで質問を提案
    span.db-v2-deals-count 業種・職種から自動生成
  .db-v2-bottom-card__body
    p.db-v2-muted style="margin-bottom:12px"
      | 業種と募集職種をもとに、面接で使いやすい質問をいくつか提案します。必要なものだけチェックして追加してください。
    .db-v2-suggest-grid
      .db-v2-form-group
        label.db-v2-form-label for="suggest-industry" 業種
        input#suggest-industry.db-v2-form-control type="text" value=(@situation.industry.to_s) placeholder="例: IT・Web" data-ai-suggest-industry="1"
      .db-v2-form-group
        label.db-v2-form-label for="suggest-job-title" 募集職種
        input#suggest-job-title.db-v2-form-control type="text" value=(@situation.job_title.to_s) placeholder="例: カスタマーサクセス" data-ai-suggest-job="1"
      .db-v2-form-group
        label.db-v2-form-label for="suggest-count" 提案数
        select#suggest-count.db-v2-form-control data-ai-suggest-count="1"
          option value="3" 3問
          option value="5" selected="selected" 5問
          option value="8" 8問
    .db-v2-form-actions style="margin-top:4px"
      button.db-v2-btn.db-v2-btn--primary type="button" data-ai-suggest-run="1"
        i.fa-solid.fa-wand-magic-sparkles aria-hidden="true"
        span 質問を提案する
      span.db-v2-muted data-ai-suggest-status="1"

    .db-v2-suggest-results data-ai-suggest-results="1" hidden=true
      p.db-v2-muted style="margin:16px 0 8px" 提案結果（追加したい質問にチェック）
      .db-v2-suggest-list data-ai-suggest-list="1"
      .db-v2-form-actions style="margin-top:12px"
        button.db-v2-btn.db-v2-btn--primary type="button" data-ai-suggest-apply="1" disabled=true
          i.fa-solid.fa-plus aria-hidden="true"
          span 選択した質問を追加
        button.db-v2-btn.db-v2-btn--ghost type="button" data-ai-suggest-select-all="1" すべて選択
        button.db-v2-btn.db-v2-btn--ghost type="button" data-ai-suggest-clear="1" 選択解除

.db-v2-bottom-card style="margin-top: 1.25rem"
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title 質問一覧
    span.db-v2-deals-count = "#{@questions.size} 問"
  .db-v2-bottom-card__body
    - if @questions.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-circle-question aria-hidden="true"
        p.db-v2-empty-state__text まだ質問がありません。最低1問必要です。
        = link_to new_situation_question_path(@situation), class: "db-v2-btn db-v2-btn--primary" do
          span 最初の質問を追加
    - else
      ol.db-v2-question-list
        - @questions.each do |q|
          li.db-v2-question-list__item
            .db-v2-question-list__order
              span.db-v2-question-list__num = q.order
            .db-v2-question-list__main
              p.db-v2-question-list__text = q.question_text
              .db-v2-question-list__meta
                span.db-v2-question-list__chip = question_type_label(q.question_type)
                - if q.published?
                  span.db-v2-question-list__chip.db-v2-question-list__chip--required 公開
                - else
                  span.db-v2-question-list__chip.db-v2-question-list__chip--optional 下書き
                - if q.required?
                  span.db-v2-question-list__chip.db-v2-question-list__chip--required 必須
                - else
                  span.db-v2-question-list__chip.db-v2-question-list__chip--optional 任意
                - if q.has_branching_rules?
                  span.db-v2-question-list__chip 分岐あり
            .db-v2-question-list__actions
              = button_to toggle_publish_situation_question_path(@situation, q), method: :post, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" } do
                span = q.published? ? "非公開にする" : "公開する"
              = link_to edit_situation_question_path(@situation, q), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                i.fa-solid.fa-pen aria-hidden="true"
                span 編集
              = button_to situation_question_path(@situation, q), method: :delete, class: "db-v2-btn db-v2-btn--danger db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo_confirm: "この質問を削除しますか？", confirm: "この質問を削除しますか？" } do
                i.fa-solid.fa-trash aria-hidden="true"
                span 削除

.db-v2-bottom-card style="margin-top: 1.25rem"
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title 追加設定
  .db-v2-bottom-card__body
    - if @analytics.present?
      details.db-v2-details
        summary.db-v2-details__summary このシナリオのファネル
        .db-v2-details__body
          p.db-v2-muted
            | 閲覧 #{@analytics[:page_views]} → 登録 #{@analytics[:registered_count]} → 完了 #{@analytics[:sessions_completed]}（完了率 #{@analytics[:completion_rate] || "—"}%）／合格 #{@analytics[:passed_count]}

    details.db-v2-details
      summary.db-v2-details__summary 受験者登録項目
      .db-v2-details__body
        = form_with url: update_candidate_registration_situation_path(@situation), method: :patch, local: true do
          .db-v2-form-check style="margin-bottom:12px"
            = check_box_tag "situation[skip_candidate_registration]", "1", @situation.skip_candidate_registration?, id: "skip_candidate_registration"
            = label_tag "skip_candidate_registration", "登録をスキップする"
          - fields = @situation.resolved_candidate_info_fields
          - SituationCandidateRegistration::CANDIDATE_INFO_FIELDS.each do |key|
            .db-v2-form-group
              label.db-v2-form-label = SituationCandidateRegistration::FIELD_LABELS[key]
              = select_tag "situation[candidate_info_fields][#{key}]", options_for_select([["必須", "required"], ["任意", "optional"], ["非表示", "hidden"]], fields[key]), class: "db-v2-form-control"
          button.db-v2-btn.db-v2-btn--primary type="submit" 登録項目を保存

    details.db-v2-details
      summary.db-v2-details__summary 募集資料・FAQ
      .db-v2-details__body
        - if @situation.recruitment_material.attached?
          p
            = link_to @situation.recruitment_material.filename.to_s, rails_blob_path(@situation.recruitment_material, disposition: "attachment"), class: "db-v2-deals-table__link"
            = button_to "削除", remove_recruitment_material_situation_path(@situation), method: :delete, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form", style: "display:inline;margin-left:8px" }
        = form_with url: upload_recruitment_material_situation_path(@situation), method: :post, local: true, html: { multipart: true } do
          .db-v2-form-group
            label.db-v2-form-label 募集要項・会社紹介PDFなど
            = file_field_tag :recruitment_material, class: "db-v2-form-control", accept: ".pdf,.doc,.docx,.png,.jpg"
          button.db-v2-btn.db-v2-btn--ghost type="submit" 資料をアップロード

        hr style="margin:16px 0;border:none;border-top:1px solid var(--db-v2-border, #e2e8f0)"
        h3.db-v2-form-section__title style="margin-bottom:8px" FAQ
        - @faqs.each do |faq|
          .db-v2-page-card style="margin-bottom:8px"
            strong = faq.question
            p.db-v2-muted = faq.answer
            = button_to "削除", situation_situation_faq_path(@situation, faq), method: :delete, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" }
        = form_with model: [@situation, SituationFaq.new], url: situation_situation_faqs_path(@situation), local: true do |f|
          .db-v2-form-group
            = f.label :question, "質問", class: "db-v2-form-label"
            = f.text_field :question, class: "db-v2-form-control", required: true
          .db-v2-form-group
            = f.label :answer, "回答", class: "db-v2-form-label"
            = f.text_area :answer, class: "db-v2-form-control", rows: 3, required: true
          .db-v2-form-group
            = f.label :category, "カテゴリ", class: "db-v2-form-label"
            = f.text_field :category, class: "db-v2-form-control", placeholder: "勤務条件・福利厚生など"
          button.db-v2-btn.db-v2-btn--primary type="submit" FAQを追加

    details.db-v2-details
      summary.db-v2-details__summary フォロー自動化
      .db-v2-details__body
        - unless @situation.client&.follow_up_automation_enabled?
          p.db-v2-muted style="margin-bottom:12px" 現在のプランではフォロー自動化は無効です（Standard以上で有効）。設定は保存できます。
        = form_with url: update_follow_up_settings_situation_path(@situation), method: :patch, local: true do
          .db-v2-form-group
            label.db-v2-form-label 次のステップURL（選考案内・日程調整など）
            = url_field_tag "situation[follow_up_next_step_url]", @situation.follow_up_next_step_url, class: "db-v2-form-control", placeholder: "https://..."
          - @follow_up_templates.each do |template|
            .db-v2-page-card style="margin-bottom:12px"
              .db-v2-form-check
                = check_box_tag "templates[#{template.id}][enabled]", "1", template.enabled?, id: "tpl_enabled_#{template.id}"
                = label_tag "tpl_enabled_#{template.id}", "#{template.kind} / #{template.delay_days}日後"
              .db-v2-form-group
                = label_tag "templates_#{template.id}_delay", "遅延日数", class: "db-v2-form-label"
                = number_field_tag "templates[#{template.id}][delay_days]", template.delay_days, class: "db-v2-form-control", min: 0, max: 90
              .db-v2-form-group
                = label_tag "templates_#{template.id}_subject", "件名", class: "db-v2-form-label"
                = text_field_tag "templates[#{template.id}][subject]", template.subject, class: "db-v2-form-control"
              .db-v2-form-group
                = label_tag "templates_#{template.id}_body", "本文", class: "db-v2-form-label"
                = text_area_tag "templates[#{template.id}][body]", template.body, class: "db-v2-form-control", rows: 4
              .db-v2-form-check
                = check_box_tag "templates[#{template.id}][include_next_step_link]", "1", template.include_next_step_link?, id: "tpl_link_#{template.id}"
                = label_tag "tpl_link_#{template.id}", "次のステップリンクを含める"
              p.db-v2-form-hint 変数: {{candidate_name}} / {{company}} / {{situation_title}} / {{invite_url}}
          button.db-v2-btn.db-v2-btn--primary type="submit" フォロー設定を保存
