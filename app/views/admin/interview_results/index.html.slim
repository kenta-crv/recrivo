.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("recrivo.dashboard.results.title")
    p.db-v2-header__subtitle = t("recrivo.dashboard.results.admin_subtitle")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.results.admin_list_title")
    span.db-v2-deals-count = t("recrivo.dashboard.common.count", count: @results.size)

  .db-v2-bottom-card__body
    - if @results.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-clipboard-list aria-hidden="true"
        p.db-v2-empty-state__text = t("recrivo.dashboard.results.admin_empty")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th = t("recrivo.dashboard.results.col_id")
              th = t("recrivo.dashboard.results.admin_col_candidate")
              th = t("recrivo.dashboard.results.col_scenario")
              th = t("recrivo.dashboard.results.admin_col_status")
              th = t("recrivo.dashboard.results.admin_col_score")
              th = t("recrivo.dashboard.results.admin_col_created")
              th
          tbody
            - @results.each do |result|
              tr
                td = result.id
                td = result.interview.user&.email
                td = result.interview.situation&.title
                td = final_status_label(result.final_status)
                td = result.average_score
                td = l(result.created_at, format: :short)
                td
                  = link_to t("recrivo.dashboard.common.detail"), admin_interview_result_path(result), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"
