.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("recrivo.dashboard.results.admin_title", id: @result.id)
    p.db-v2-header__subtitle = @result.interview.situation&.title
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to admin_interview_results_path, class: "db-v2-btn db-v2-btn--ghost" do
      i.fa-solid.fa-arrow-left aria-hidden="true"
      span = t("recrivo.dashboard.results.admin_back")

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.results.admin_summary")
  .db-v2-bottom-card__body
    .db-v2-summary-grid
      .db-v2-summary-card
        span.db-v2-summary-card__label = t("recrivo.dashboard.results.admin_applicant")
        span.db-v2-summary-card__value = @result.interview.user&.email
      .db-v2-summary-card
        span.db-v2-summary-card__label = t("recrivo.dashboard.results.admin_col_status")
        span.db-v2-summary-card__value = final_status_label(@result.final_status)
      .db-v2-summary-card
        span.db-v2-summary-card__label = t("recrivo.dashboard.results.admin_col_score")
        span.db-v2-summary-card__value = @result.average_score

    - if @result.summary.present?
      p = @result.summary

    - if Array(@result.strengths).any?
      h3 = t("recrivo.dashboard.results.strengths")
      ul
        - Array(@result.strengths).each do |item|
          li = item

    - if Array(@result.weaknesses).any?
      h3 = t("recrivo.dashboard.results.admin_weaknesses")
      ul
        - Array(@result.weaknesses).each do |item|
          li = item

    - if @result.recommendation.present?
      h3 = t("recrivo.dashboard.results.admin_recommendation")
      p = @result.recommendation

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.results.admin_answers")
  .db-v2-bottom-card__body
    - @result.interview.interview_responses.in_order.each do |resp|
      .db-v2-lead-card
        p.db-v2-lead-card__title = resp.question.question_text
        p
          = t("recrivo.dashboard.results.score_label")
          = resp.score
        p = resp.audio_transcript
        - if resp.answer_audio.attached?
          p = link_to t("recrivo.dashboard.results.admin_audio"), rails_blob_path(resp.answer_audio, disposition: "attachment", only_path: true), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"
        - if resp.answer_video.attached?
          p
            = link_to t("recrivo.dashboard.results.admin_video"), rails_blob_path(resp.answer_video, disposition: "attachment", only_path: true), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"
            |  
            video controls=true preload="metadata" style="display:block;max-height:180px;max-width:100%;margin-top:8px;" src=rails_blob_path(resp.answer_video, only_path: true)
