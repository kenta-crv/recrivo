.db-v2-header
  .db-v2-header__left
    nav.db-v2-breadcrumb aria-label=t("recrivo.dashboard.common.breadcrumb")
      = link_to t("recrivo.dashboard.questions.crumb_situations"), situations_path, class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      = link_to @situation.title, situation_path(@situation), class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      span.db-v2-breadcrumb__current = t("recrivo.dashboard.questions.new_current")
    h1.db-v2-header__title = t("recrivo.dashboard.questions.new_title")
    p.db-v2-header__subtitle = @situation.title
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.questions.content_title")
  .db-v2-bottom-card__body
    - if @question.errors.any?
      .db-v2-alert.db-v2-alert--danger
        i.fa-solid.fa-circle-exclamation aria-hidden="true"
        p = @question.errors.full_messages.to_sentence
    = render "form"
