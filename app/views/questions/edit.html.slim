.db-v2-header
  .db-v2-header__left
    nav.db-v2-breadcrumb aria-label="パンくず"
      = link_to "シナリオ", situations_path, class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      = link_to @situation.title, situation_path(@situation), class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      span.db-v2-breadcrumb__current 質問編集
    h1.db-v2-header__title 質問を編集
    p.db-v2-header__subtitle = @situation.title
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title 質問内容
  .db-v2-bottom-card__body
    - if @question.errors.any?
      .db-v2-alert.db-v2-alert--danger
        i.fa-solid.fa-circle-exclamation aria-hidden="true"
        p = @question.errors.full_messages.to_sentence
    = render "form"
