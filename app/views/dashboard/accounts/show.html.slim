= form_with model: @client, url: dashboard_account_path, method: :patch, local: true do |f|
  - if @client.errors.any?
    .db-v2-bottom-card style="margin-bottom:1.25rem"
      .db-v2-bottom-card__body
        .db-v2-alert.db-v2-alert--danger
          ul
            - @client.errors.full_messages.each do |message|
              li = message

  .db-v2-bottom-card
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title
        i.fa-solid.fa-building aria-hidden="true"
        |  企業情報
    .db-v2-bottom-card__body
      .db-v2-form-group
        = f.label :company, "会社名", class: "db-v2-form-label"
        = f.text_field :company, class: "db-v2-form-control", required: true

      .db-v2-form-group
        = f.label :name, "担当者名", class: "db-v2-form-label"
        = f.text_field :name, class: "db-v2-form-control", required: true

      .db-v2-form-group
        = f.label :email, "メールアドレス", class: "db-v2-form-label"
        = f.email_field :email, class: "db-v2-form-control", required: true

      .db-v2-form-group
        = f.label :tel, "電話番号", class: "db-v2-form-label"
        = f.telephone_field :tel, class: "db-v2-form-control", required: true

      .db-v2-form-group
        = f.label :address, "住所", class: "db-v2-form-label"
        = f.text_field :address, class: "db-v2-form-control", required: true

      .db-v2-form-group
        = f.label :url, "URL", class: "db-v2-form-label"
        = f.url_field :url, class: "db-v2-form-control", placeholder: "https://example.com"

  .db-v2-bottom-card style="margin-top:1.25rem"
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title
        i.fa-solid.fa-envelope aria-hidden="true"
        |  採用・不採用メール文面
    .db-v2-bottom-card__body
      p.db-v2-muted.db-v2-account-email__lead
        | 面接管理から送る採用・不採用メールの文面です。空欄の項目はシステム標準文面を使います。
      p.db-v2-muted.db-v2-account-email__vars-label 差し込み変数（そのままコピーして使えます）
      .db-v2-account-email__vars
        - %w[{{candidate_name}} {{candidate_email}} {{company}} {{situation_title}} {{average_score}}].each do |var|
          code.db-v2-account-email__var = var

      - hire_subject_ph = "空欄でデフォルト（【採用のご連絡】{{company}}）"
      - reject_subject_ph = "空欄でデフォルト（【選考結果のご連絡】{{company}}）"

      .db-v2-form-group
        = f.label :hire_email_subject, "採用メール件名", class: "db-v2-form-label"
        = f.text_field :hire_email_subject, class: "db-v2-form-control", placeholder: hire_subject_ph

      .db-v2-form-group
        = f.label :hire_email_body, "採用メール本文", class: "db-v2-form-label"
        = f.text_area :hire_email_body, class: "db-v2-form-control", rows: 10, placeholder: "空欄でデフォルトの採用通知文面を使用"

      .db-v2-form-group
        = f.label :reject_email_subject, "不採用メール件名", class: "db-v2-form-label"
        = f.text_field :reject_email_subject, class: "db-v2-form-control", placeholder: reject_subject_ph

      .db-v2-form-group
        = f.label :reject_email_body, "不採用メール本文", class: "db-v2-form-label"
        = f.text_area :reject_email_body, class: "db-v2-form-control", rows: 10, placeholder: "空欄でデフォルトの不採用通知文面を使用"

      .db-v2-form-actions
        = f.submit "保存する", class: "db-v2-btn db-v2-btn--primary"
