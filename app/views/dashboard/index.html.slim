.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title こんにちは、#{@display_name} さん
    p.db-v2-header__subtitle AI面接の運用サマリー
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
      i.fa-solid.fa-plus aria-hidden="true"
      span シナリオを作成

.db-v2-summary-grid.db-v2-summary-grid--3
  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--blue
      i.fa-solid.fa-list-check aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label シナリオ
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = @situations_count
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label 有効 #{@active_situations_count} 件

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--green
      i.fa-solid.fa-clipboard-check aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label 評価済み
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = @results_count
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label 累計の評価済み面接

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--purple
      i.fa-solid.fa-calendar-check aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label 今月の面接
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = @interviews_this_month
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - if admin_signed_in?
            | 全企業の合計
          - elsif @monthly_limit
            | 上限 #{@monthly_limit} 件
          - else
            | 上限なし

.db-v2-summary-grid.db-v2-summary-grid--3
  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--gold
      i.fa-solid.fa-star aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label 平均点
      .db-v2-summary-card__value-row
        - if @average_score
          span.db-v2-summary-card__value = @average_score
          span.db-v2-summary-card__unit 点
        - else
          span.db-v2-summary-card__value —
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label 評価済み面接の平均（満点100）

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--rose
      i.fa-solid.fa-person-walking-arrow-right aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label 離脱率
      .db-v2-summary-card__value-row
        - if @abandon_rate.nil?
          span.db-v2-summary-card__value —
        - else
          span.db-v2-summary-card__value = @abandon_rate
          span.db-v2-summary-card__unit ％
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - if @decided_interview_count.to_i.zero?
            | まだ終了した面接がありません
          - else
            = "途中離脱 #{@abandoned_count}／開始 #{@analytics[:sessions_started]}"

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--blue
      i.fa-solid.fa-filter aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label 完了率
      .db-v2-summary-card__value-row
        - if @analytics[:completion_rate]
          span.db-v2-summary-card__value = @analytics[:completion_rate]
          span.db-v2-summary-card__unit ％
        - else
          span.db-v2-summary-card__value —
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          = "閲覧 #{@analytics[:page_views]} → 登録 #{@analytics[:registered_count]} → 完了 #{@analytics[:sessions_completed]}"

.db-v2-experience-bar class=(@experience_has_gaps ? "db-v2-experience-bar--alert" : nil)
  .db-v2-experience-bar__main
    - if @experience_has_gaps
      span.db-v2-experience-issue__mark aria-hidden="true" !
    - else
      .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--teal
        i.fa-solid.fa-chart-pie aria-hidden="true"
    .db-v2-experience-bar__text
      span.db-v2-experience-bar__label 候補者体験の充実度
      span.db-v2-experience-bar__score
        - if @experience_score
          strong = @experience_score
          span.db-v2-muted ／100
        - else
          strong —
  = link_to "状況を確認", dashboard_candidate_experience_path, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"

- if @analytics[:funnel_segments].present?
  .db-v2-bottom-card style="margin-top: 1.25rem"
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title 進捗の内訳
    .db-v2-bottom-card__body
      .db-v2-funnel-pie__legends style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px"
        - @analytics[:funnel_segments].each do |seg|
          .db-v2-funnel-pie__legend
            span.db-v2-funnel-pie__badge style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#{seg[:color]};margin-right:6px"
            span.db-v2-funnel-pie__legend-label = seg[:label]
            span.db-v2-muted = " #{seg[:count]}件（#{seg[:share]}%）"
      p.db-v2-muted style="margin-top:12px"
        | 合格 #{@analytics[:passed_count]} ／ 審査待ち #{@analytics[:pending_review_count]} ／ フォロー送信 #{@analytics[:follow_up_sent]}（開封 #{@analytics[:follow_up_opened]}）
        - if @analytics[:average_satisfaction]
          |  ／ 満足度平均 #{@analytics[:average_satisfaction]}

.db-v2-bottom-card style="margin-top: 1.25rem"
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title 最近の面接
    = link_to "すべて見る", dashboard_candidates_path, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
  .db-v2-bottom-card__body
    - if @recent_candidates.blank?
      .db-v2-empty-state
        p.db-v2-empty-state__text まだ面接がありません
        p.db-v2-muted シナリオを作成し、招待リンクを候補者へ共有してください。
        - unless admin_signed_in?
          = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
            span シナリオを作成
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th 候補者
              th シナリオ
              th 運用
              th 判定
              th スコア
              th 更新
              th
          tbody
            - @recent_candidates.each do |interview|
              - result = interview.interview_result
              tr
                td = interview.user&.name.presence || interview.user&.email
                td = interview.situation&.title
                td
                  span class=ops_status_badge_class(interview.ops_status) = ops_status_label(interview.ops_status)
                td
                  - if result
                    span class=final_status_badge_class(result.final_status) = final_status_label(result.final_status)
                  - else
                    span.db-v2-muted —
                td = result&.average_score || "—"
                td = l(interview.updated_at, format: :short)
                td
                  = link_to dashboard_candidate_path(interview), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                    span 詳細
