.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("recrivo.dashboard.candidates.title")
    p.db-v2-header__subtitle = t("recrivo.dashboard.candidates.subtitle")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__body
    = form_with url: dashboard_candidates_path, method: :get, local: true, html: { class: "db-v2-suggest-grid", style: "margin-bottom:16px" } do
      .db-v2-form-group
        label.db-v2-form-label = t("recrivo.dashboard.candidates.filter_scenario")
        = select_tag :situation_id, options_from_collection_for_select(@situations, :id, :title, @situation_filter), include_blank: t("recrivo.dashboard.common.all"), class: "db-v2-form-control"
      .db-v2-form-group
        label.db-v2-form-label = t("recrivo.dashboard.candidates.filter_ops")
        = select_tag :ops_status, options_for_select(ops_status_options, @ops_filter), include_blank: t("recrivo.dashboard.common.all"), class: "db-v2-form-control"
      .db-v2-form-group
        label.db-v2-form-label &nbsp;
        button.db-v2-btn.db-v2-btn--primary type="submit" = t("recrivo.dashboard.candidates.filter_submit")

    - if @interviews.blank?
      .db-v2-empty-state
        p.db-v2-empty-state__text = t("recrivo.dashboard.candidates.empty")
        p.db-v2-muted = t("recrivo.dashboard.candidates.empty_lead")
        - unless admin_signed_in?
          = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
            span = t("recrivo.dashboard.home.create_scenario")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th = t("recrivo.dashboard.candidates.col_id")
              th = t("recrivo.dashboard.candidates.col_candidate")
              th = t("recrivo.dashboard.candidates.col_scenario")
              th = t("recrivo.dashboard.candidates.col_interview")
              th = t("recrivo.dashboard.candidates.col_ops")
              th = t("recrivo.dashboard.candidates.col_decision")
              th = t("recrivo.dashboard.candidates.col_score")
              th = t("recrivo.dashboard.candidates.col_updated")
              th
          tbody
            - @interviews.each do |interview|
              - result = interview.interview_result
              - user = interview.user
              tr
                td = interview.id
                td
                  .db-v2-result-candidate
                    span.db-v2-result-candidate__name = user&.name.presence || "—"
                    span.db-v2-result-candidate__meta = [user&.email, user&.tel.presence].compact.join(" / ")
                td = interview.situation&.title
                td = interview_status_label(interview.status)
                td
                  span class=ops_status_badge_class(interview.ops_status) = ops_status_label(interview.ops_status)
                td
                  - if result
                    span class=final_status_badge_class(result.final_status) = final_status_label(result.final_status)
                  - else
                    span.db-v2-muted —
                td = result&.average_score || "—"
                td = l(interview.updated_at, format: :short)
                td
                  .db-v2-result-actions
                    = link_to t("recrivo.dashboard.common.detail"), dashboard_candidate_path(interview), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
                    - if result
                      = link_to t("recrivo.dashboard.candidates.evaluation"), dashboard_interview_result_path(result), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
