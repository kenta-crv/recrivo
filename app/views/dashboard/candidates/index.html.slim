.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title 面接管理
    p.db-v2-header__subtitle 候補者・評価・合否をまとめて確認できます
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__body
    = form_with url: dashboard_candidates_path, method: :get, local: true, html: { class: "db-v2-suggest-grid", style: "margin-bottom:16px" } do
      .db-v2-form-group
        label.db-v2-form-label シナリオ
        = select_tag :situation_id, options_from_collection_for_select(@situations, :id, :title, @situation_filter), include_blank: "すべて", class: "db-v2-form-control"
      .db-v2-form-group
        label.db-v2-form-label 運用ステータス
        = select_tag :ops_status, options_for_select(ops_status_options, @ops_filter), include_blank: "すべて", class: "db-v2-form-control"
      .db-v2-form-group
        label.db-v2-form-label &nbsp;
        button.db-v2-btn.db-v2-btn--primary type="submit" 絞り込み

    - if @interviews.blank?
      .db-v2-empty-state
        p.db-v2-empty-state__text まだ面接がありません
        p.db-v2-muted シナリオを作成し、招待リンクを候補者へ共有してください。
        - unless admin_signed_in?
          = link_to new_situation_path, class: "db-v2-btn db-v2-btn--primary" do
            span シナリオを作成
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th ID
              th 候補者
              th シナリオ
              th 面接
              th 運用
              th 判定
              th スコア
              th 更新
              th
          tbody
            - @interviews.each do |interview|
              - result = interview.interview_result
              - user = interview.user
              tr
                td = interview.id
                td
                  .db-v2-result-candidate
                    span.db-v2-result-candidate__name = user&.name.presence || "—"
                    span.db-v2-result-candidate__meta = [user&.email, user&.tel.presence].compact.join(" / ")
                td = interview.situation&.title
                td = interview_status_label(interview.status)
                td
                  span class=ops_status_badge_class(interview.ops_status) = ops_status_label(interview.ops_status)
                td
                  - if result
                    span class=final_status_badge_class(result.final_status) = final_status_label(result.final_status)
                  - else
                    span.db-v2-muted —
                td = result&.average_score || "—"
                td = l(interview.updated_at, format: :short)
                td
                  .db-v2-result-actions
                    = link_to "詳細", dashboard_candidate_path(interview), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
                    - if result
                      = link_to "評価", dashboard_interview_result_path(result), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs"
