.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("recrivo.dashboard.results.title")
    p.db-v2-header__subtitle = t("recrivo.dashboard.results.subtitle")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("recrivo.dashboard.results.list_title")
    span.db-v2-deals-count = t("recrivo.dashboard.common.count", count: @results.size)
  .db-v2-bottom-card__body
    - if @results.blank?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-clipboard-list aria-hidden="true"
        p.db-v2-empty-state__text = t("recrivo.dashboard.results.empty")
        = link_to situations_path, class: "db-v2-btn db-v2-btn--primary" do
          span = t("recrivo.dashboard.results.to_situations")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table.db-v2-results-table
          thead
            tr
              th.db-v2-results-table__col-id = t("recrivo.dashboard.results.col_id")
              th.db-v2-results-table__col-candidate = t("recrivo.dashboard.results.col_candidate")
              th.db-v2-results-table__col-scenario = t("recrivo.dashboard.results.col_scenario")
              th.db-v2-results-table__col-status = t("recrivo.dashboard.results.col_decision")
              th.db-v2-results-table__col-score = t("recrivo.dashboard.results.col_score")
              th.db-v2-results-table__col-date = t("recrivo.dashboard.results.col_date")
              th.db-v2-results-table__col-actions = t("recrivo.dashboard.results.col_actions")
          tbody
            - @results.each do |result|
              tr
                td.db-v2-deals-table__id.db-v2-results-table__col-id = result.id
                td.db-v2-results-table__col-candidate
                  - user = result.interview.user
                  - if user
                    .db-v2-result-candidate
                      span.db-v2-result-candidate__name = user.name.presence || "—"
                      span.db-v2-result-candidate__meta = [user.email, user.tel.presence].compact.join(" / ")
                  - else
                    | —
                td.db-v2-results-table__col-scenario = result.interview.situation&.title
                td.db-v2-results-table__col-status
                  span class=final_status_badge_class(result.final_status) = final_status_label(result.final_status)
                td.db-v2-results-table__col-score = result.average_score
                td.db-v2-results-table__col-date = l(result.created_at, format: :short)
                td.db-v2-deals-table__actions.db-v2-results-table__col-actions
                  .db-v2-result-actions
                    = button_to t("recrivo.dashboard.results.hire"), notify_hire_dashboard_interview_result_path(result), method: :post, form: { class: "db-v2-inline-form" }, class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs", data: { confirm: t("recrivo.dashboard.results.hire_confirm") }
                    = button_to t("recrivo.dashboard.results.reject"), notify_reject_dashboard_interview_result_path(result), method: :post, form: { class: "db-v2-inline-form" }, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", data: { confirm: t("recrivo.dashboard.results.reject_confirm") }
                    = link_to dashboard_interview_result_path(result), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                      span = t("recrivo.dashboard.common.detail")
